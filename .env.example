# ==============================================================================
# TELE-INTEL-BOT - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy file này thành .env và điền các giá trị thực tế trước khi khởi động bot.
# ==============================================================================

# Telegram Bot Token (lấy từ @BotFather trên Telegram)
BOT_TOKEN=

# Telegram Chat ID của Admin (dùng để khóa quyền truy cập - Zero-Trust Admin Lock)
ADMIN_CHAT_ID=

# OpenRouter API Key (Truy cập DeepSeek, Llama 3, Qwen, Claude, OpenAI...)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# Cấu hình Model AI (OpenRouter - BẮT BUỘC kết thúc bằng :free)
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning:free
LLM_DAILY_LIMIT=40

# Cấu hình kết nối cơ sở dữ liệu MySQL
# QUAN TRỌNG: Chỉ dùng ký tự chữ-số (a-z, A-Z, 0-9) cho mật khẩu.
# KHÔNG dùng: $, #, ", ', khoảng trắng, dấu gạch chéo ngược (\).
# Lý do: Các ký tự đặc biệt gây lỗi phân tích trong Docker Compose và shell.
# MYSQL_PASSWORD và MYSQL_ROOT_PASSWORD phải khác nhau.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your-bot-password-here-alphanumeric-only
MYSQL_ROOT_PASSWORD=your-root-password-here-alphanumeric-only
MYSQL_DATABASE=tele_intel_bot
